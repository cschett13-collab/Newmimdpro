# === Portal auth ===
# Session JWT secret (generate with: openssl rand -hex 32)
PORTAL_SESSION_SECRET=change-me-to-a-long-random-string

# Admin/owner login. Used at /login by Fox Valley Client Engine staff.
PORTAL_ADMIN_EMAIL=owner@foxvalleyclientengine.com
PORTAL_ADMIN_PASSWORD=change-me

# === HighLevel clients ===
# The portal reads clients from a JSON array in PORTAL_CLIENTS.
# Each client is one HighLevel sub-account (location). To add a client,
# create a Private Integration Token (PIT) inside that sub-account:
#   Settings -> Private Integrations -> Create
# Then add an entry below. Example (single line, JSON-encoded):
#
# PORTAL_CLIENTS=[{"id":"acme","name":"Acme Dental","locationId":"abc123","pit":"pit-..."}]
#
PORTAL_CLIENTS=[]

# === Claude / Anthropic ===
# Powers the AI insights panel on the dashboard, the /ai chat assistant per
# client, and the reply-suggestion buttons on the Conversations page. Get a
# key from https://console.anthropic.com/settings/keys. If unset, those three
# features show a "configure ANTHROPIC_API_KEY" notice and the rest of the
# portal works normally.
ANTHROPIC_API_KEY=

# === Public sales funnel (/start) ===
# Stripe Payment Link URLs. Create them at:
#   https://dashboard.stripe.com/payment-links
# Leave blank and the CTA will scroll to the lead-capture form instead.
STRIPE_CHECKOUT_STARTER=
STRIPE_CHECKOUT_PRO=
STRIPE_CHECKOUT_MANAGED=

# Where leads from the contact form get pushed. ANY of these will work:
#   - Zapier "Catch Hook" URL  (then -> email/Sheets/SMS/etc.)
#   - Make.com webhook URL
#   - Discord channel webhook URL  (instant phone notifications)
#   - Slack incoming webhook URL
# If left blank, leads are still saved to the server logs.
LEAD_WEBHOOK_URL=

# Optional copy overrides — change these without editing code.
OFFER_BRAND=Fox Valley Client Engine
OFFER_HEADLINE=Your HighLevel account, fully built and live in 48 hours.
OFFER_SUBHEAD=We install pipelines, automations, calendars, forms, and review requests so leads stop falling through the cracks. Done-for-you. Flat fee. No retainers required.
OFFER_BOOKING_URL=
OFFER_CONTACT_EMAIL=hello@example.com

# === docker compose: ports ===
# Override if the defaults clash with other services on the NAS.
PORTAL_PORT=8080
PORTAINER_PORT=9443

# === SMTP dispatcher (workers/email_dispatcher) ===
# All variables here are REQUIRED for the dispatcher container to start.
# It refuses to boot if any are missing — CAN-SPAM compliance is mandatory.
#
# Defaults assume Mailgun on the `mg.` sending subdomain (see docs/email-setup.md).
# Mailgun's SMTP user is ALWAYS `postmaster@mg.<your-domain>`; using the apex
# domain will fail authentication.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.foxvalleyclientengine.com
SMTP_PASSWORD=change-me

# Envelope sender must be on the verified Mailgun subdomain. Reply-To can
# point at your real inbox on the apex domain so replies land where you read.
DISPATCHER_FROM_NAME=Fox Valley Client Engine
DISPATCHER_FROM_EMAIL=outreach@mg.foxvalleyclientengine.com
DISPATCHER_REPLY_TO=hello@foxvalleyclientengine.com
DISPATCHER_UNSUBSCRIBE_EMAIL=unsubscribe@foxvalleyclientengine.com

# REQUIRED by CAN-SPAM: a valid physical postal address goes in every
# outbound email's footer. Don't ship without filling this in.
DISPATCHER_BUSINESS_NAME=Fox Valley Client Engine
DISPATCHER_POSTAL_ADDRESS=123 Example St, Appleton, WI 54911, USA

# Tunables (defaults shown). Polling is continuous; the container sleeps
# DISPATCHER_POLL_SECONDS between batches.
DISPATCHER_POLL_SECONDS=300
DISPATCHER_BATCH_SIZE=10
DISPATCHER_MAX_ATTEMPTS=3
