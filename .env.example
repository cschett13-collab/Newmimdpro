# === Portal auth ===
# Session JWT secret (generate with: openssl rand -hex 32)
PORTAL_SESSION_SECRET=change-me-to-a-long-random-string

# Admin/owner login. Used at /login by Fox Valley Client Engine staff.
PORTAL_ADMIN_EMAIL=owner@foxvalleyclientengine.com
PORTAL_ADMIN_PASSWORD=change-me

# === HighLevel clients ===
# The portal reads clients from a JSON array in PORTAL_CLIENTS.
# Each client is one HighLevel sub-account (location). To add a client,
# create a Private Integration Token (PIT) inside that sub-account:
#   Settings -> Private Integrations -> Create
# Then add an entry below. Example (single line, JSON-encoded):
#
# PORTAL_CLIENTS=[{"id":"acme","name":"Acme Dental","locationId":"abc123","pit":"pit-..."}]
#
PORTAL_CLIENTS=[]

# === Marketing / lead-gen scripts (scripts/marketing/) ===
# These are NOT used by the Next.js app. They are CLI helpers for running
# IMD's own AI lead-gen stack. See docs/MARKETING_PLAYBOOK.md for the full
# strategy.

# Anthropic API key — used by all marketing scripts (ad gen, intake bot,
# cold-email personalization).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-7

# Telegram intake bot — get a token from @BotFather, then point this at it.
TELEGRAM_BOT_TOKEN=
# Public Calendly / HighLevel booking link the bot hands qualified leads.
IMD_CALENDAR_LINK=https://calendly.com/imd
# HighLevel inbound webhook URL: in HL, build a workflow with an "Inbound
# Webhook" trigger -> map fields -> create contact + opportunity. Paste the
# webhook URL here so the bot can push qualified leads into the CRM.
HL_INBOUND_WEBHOOK_URL=

# Service area defaults (Neenah, WI + 100mi). Override per-campaign on the
# command line; these are just the script defaults.
IMD_HQ_CITY=Neenah, WI
IMD_SERVICE_RADIUS_MI=100
