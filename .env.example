# === Portal auth ===
# Session JWT secret (generate with: openssl rand -hex 32)
PORTAL_SESSION_SECRET=change-me-to-a-long-random-string

# Admin/owner login. Used at /login by Fox Valley Client Engine staff.
PORTAL_ADMIN_EMAIL=owner@foxvalleyclientengine.com
PORTAL_ADMIN_PASSWORD=change-me

# === HighLevel clients ===
# The portal reads clients from a JSON array in PORTAL_CLIENTS.
# Each client is one HighLevel sub-account (location). To add a client,
# create a Private Integration Token (PIT) inside that sub-account:
#   Settings -> Private Integrations -> Create
# Then add an entry below. Example (single line, JSON-encoded):
#
# PORTAL_CLIENTS=[{"id":"acme","name":"Acme Dental","locationId":"abc123","pit":"pit-..."}]
#
PORTAL_CLIENTS=[]

# === Bots / Vercel Cron ===
# Required for /api/bots/* routes. Vercel Cron sends this automatically as
# `Authorization: Bearer $CRON_SECRET` when the env var exists in the project.
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me-to-a-long-random-string

# Lead-responder bot (see src/app/api/bots/lead-responder/route.ts).
# How far back to look for newly created contacts each tick (minutes).
BOT_LEAD_RESPONDER_LOOKBACK_MIN=10
# SMS copy. Supports {{firstName}}.
BOT_LEAD_RESPONDER_TEMPLATE="Hi {{firstName}}, this is Fox Valley Client Engine — thanks for reaching out! I just got your info and someone will follow up shortly. Reply STOP to opt out."
