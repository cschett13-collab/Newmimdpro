# ============================================================
# Business
# ============================================================
BUSINESS_NAME=Fox Valley Client Engine

# ============================================================
# Instagram Graph API
# ============================================================
# Long-lived access token for the Facebook Page linked to your
# Instagram Business account. Get it from:
#   developers.facebook.com -> your app -> Graph API Explorer
# Required permissions: instagram_basic, instagram_content_publish,
# pages_read_engagement, pages_show_list, pages_manage_posts (for FB cross-post)
IG_ACCESS_TOKEN=

# The Instagram Business Account ID (NOT your @handle).
# Run:  scripts\run.bat find-ig   to discover this automatically.
IG_USER_ID=

# Graph API version
IG_GRAPH_VERSION=v21.0

# ============================================================
# Facebook cross-posting (optional)
# ============================================================
# Set CROSSPOST_TO_FACEBOOK=true and fill FB_PAGE_ID to also publish
# the same image/video to your Facebook Page.
CROSSPOST_TO_FACEBOOK=false
FB_PAGE_ID=

# ============================================================
# HighLevel (GoHighLevel / LeadConnector)
# ============================================================
# Option 1 - simplest: webhook URL from a HighLevel Inbound Webhook trigger.
HIGHLEVEL_WEBHOOK_URL=

# Option 2 - full API: Private Integration token + Location ID.
HIGHLEVEL_API_TOKEN=
HIGHLEVEL_LOCATION_ID=

# ============================================================
# AI caption generation (optional)
# ============================================================
# If set, any queue item with a blank caption gets one generated by Claude
# from the image (or hint text). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# ============================================================
# Scheduler
# ============================================================
POST_INTERVAL_HOURS=5
