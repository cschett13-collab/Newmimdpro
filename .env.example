# === Portal auth ===
# Session JWT secret (generate with: openssl rand -hex 32)
PORTAL_SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL of the deployed portal. Used to build absolute redirect URLs
# (e.g. the /api/auth/logout -> /login redirect). Defaults to http://localhost:3000.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin/owner login. Used at /login by Fox Valley Client Engine staff.
PORTAL_ADMIN_EMAIL=owner@foxvalleyclientengine.com
PORTAL_ADMIN_PASSWORD=change-me

# === HighLevel clients ===
# The portal reads clients from a JSON array in PORTAL_CLIENTS.
# Each client is one HighLevel sub-account (location). To add a client,
# create a Private Integration Token (PIT) inside that sub-account:
#   Settings -> Private Integrations -> Create
# Then add an entry below. Example (single line, JSON-encoded):
#
# PORTAL_CLIENTS=[{"id":"acme","name":"Acme Dental","locationId":"abc123","pit":"pit-..."}]
#
PORTAL_CLIENTS=[]

# === Ops data (optional) ===
# Paths to local JSON files that feed the Drafts page and the Sentinel widget.
# Relative paths resolve against the project root. Leave unset to use defaults:
#   drafts:   data/drafts.json
#   sentinel: data/sentinel-status.json
# See data/README.md for the file schemas.
# PORTAL_DRAFTS_PATH=data/drafts.json
# PORTAL_SENTINEL_STATUS_PATH=data/sentinel-status.json

# Where `npm run export-drafts` writes .eml files. Default: exports/drafts
# PORTAL_DRAFTS_EXPORT_DIR=exports/drafts
