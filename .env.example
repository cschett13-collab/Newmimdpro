# ============================================================
# Instagram Graph API
# ============================================================
# Long-lived access token for the Facebook Page linked to your
# Instagram Business account. Get it from:
#   developers.facebook.com -> your app -> Graph API Explorer
# Required permissions: instagram_basic, instagram_content_publish,
# pages_read_engagement, pages_show_list
IG_ACCESS_TOKEN=

# The Instagram Business Account ID (NOT your @handle).
# Find via: GET /{page-id}?fields=instagram_business_account
IG_USER_ID=

# Graph API version
IG_GRAPH_VERSION=v21.0

# ============================================================
# HighLevel (GoHighLevel / LeadConnector)
# ============================================================
# Option 1 - simplest: a webhook URL from your HighLevel sub-account.
# Create in HighLevel: Settings -> Webhooks, or use a Workflow
# "Inbound Webhook" trigger. We POST a JSON payload after every
# Instagram post so HighLevel can log/notify/automate.
HIGHLEVEL_WEBHOOK_URL=

# Option 2 - full API: Private Integration token + Location ID.
# Create in HighLevel: Settings -> Private Integrations.
HIGHLEVEL_API_TOKEN=
HIGHLEVEL_LOCATION_ID=

# ============================================================
# Scheduler
# ============================================================
# Interval between posts in hours.
POST_INTERVAL_HOURS=5
