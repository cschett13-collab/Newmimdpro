# === Portal auth ===
# Session JWT secret (generate with: openssl rand -hex 32)
PORTAL_SESSION_SECRET=change-me-to-a-long-random-string

# Admin/owner login. Used at /login by Fox Valley Client Engine staff.
PORTAL_ADMIN_EMAIL=owner@foxvalleyclientengine.com
PORTAL_ADMIN_PASSWORD=change-me

# === HighLevel clients ===
# The portal reads clients from a JSON array in PORTAL_CLIENTS.
# Each client is one HighLevel sub-account (location). To add a client,
# create a Private Integration Token (PIT) inside that sub-account:
#   Settings -> Private Integrations -> Create
# Then add an entry below. Example (single line, JSON-encoded):
#
# PORTAL_CLIENTS=[{"id":"acme","name":"Acme Dental","locationId":"abc123","pit":"pit-..."}]
#
PORTAL_CLIENTS=[]
