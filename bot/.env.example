# Polymarket CLOB credentials
# An EOA private key with USDC.e on Polygon and a Polymarket proxy/funder address.
PK=0xyour_private_key_here
FUNDER=0xyour_polymarket_proxy_address

# CLOB host. Use the production endpoint by default.
CLOB_HOST=https://clob.polymarket.com
WS_HOST=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Polygon mainnet
CHAIN_ID=137

# Comma-separated list of CLOB token_ids (the YES/NO outcome tokens you want
# to make markets on). Get them from the /markets endpoint or a market URL.
TOKEN_IDS=

# Strategy parameters
ORDER_SIZE_USDC=20          # notional per quote, in USDC
QUOTE_SPREAD_BPS=80         # half-spread in basis points around mid
MAX_SLIPPAGE_BPS=100        # 1% slippage cap on FOK takes
REQUOTE_INTERVAL_SEC=2.0    # min seconds between re-quotes per token
INVENTORY_CAP_USDC=200      # absolute inventory cap per token
MIN_TICK_SIZE=0.01          # fallback tick if the book doesn't advertise one
LOG_LEVEL=INFO
