# Telegram bot token from @BotFather (DM /newbot, copy the token)
TELEGRAM_BOT_TOKEN=

# Ollama server (default: local install)
OLLAMA_HOST=http://localhost:11434

# Models. /code <prompt> uses CODER_MODEL; everything else uses CHAT_MODEL.
CHAT_MODEL=qwen2.5:7b
CODER_MODEL=qwen2.5-coder:7b

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave blank to allow anyone (NOT recommended).
# Find your ID by messaging @userinfobot on Telegram.
AUTHORIZED_USER_IDS=

# System prompts (override if you want a specific persona)
CHAT_SYSTEM_PROMPT=You are Cortex AI, a helpful assistant running locally on the user's own hardware. Be concise.
CODE_SYSTEM_PROMPT=You are Cortex AI, a coding assistant. Reply with working code first, brief explanation second.
