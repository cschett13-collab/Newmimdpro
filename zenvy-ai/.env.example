# Telegram bot token from @BotFather (DM /newbot, copy the token)
TELEGRAM_BOT_TOKEN=

# === Tier (operator-side) ===
# free  = local Ollama, fully offline, no API costs (default)
# pro   = bring your own key — any OpenAI-compatible endpoint
#         (OpenAI, Anthropic via proxy, OpenRouter, Together, Groq, etc.)
ZENVY_TIER=free

# === Tier model (roadmap, for if you launch this as a multi-user product) ===
# Owner Mode      -> the operator (you) — implemented today via AUTHORIZED_USER_IDS
# User Free Mode  -> rate-limited free users (not yet implemented; needs quota table)
# User Pro Mode   -> paid hosted credits (needs payment processor + hosted backend)
# BYOK Mode       -> users supply their own API key (needs per-user key storage)
# Today the bot is single-tenant: AUTHORIZED_USER_IDS = anyone allowed to use it.

# --- free tier (local Ollama) ---
OLLAMA_HOST=http://localhost:11434
# Models — one per role:
CHAT_MODEL=llama3.1:8b           # general chat / default
CODER_MODEL=qwen2.5-coder:7b     # /code
REASONING_MODEL=deepseek-r1:8b   # /think — step-by-step reasoning
FAST_MODEL=mistral:7b            # /fast — short, lightweight, snappy

# --- pro tier (used only when ZENVY_TIER=pro) ---
# Bring your own key. Any OpenAI-compatible /v1/chat/completions endpoint works.
# ZENVY_API_URL=https://api.openai.com/v1
# ZENVY_API_KEY=
# ZENVY_PRO_CHAT_MODEL=gpt-4o-mini
# ZENVY_PRO_CODER_MODEL=gpt-4o-mini
# ZENVY_PRO_REASONING_MODEL=o1-mini
# ZENVY_PRO_FAST_MODEL=gpt-4o-mini

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave blank to allow anyone (NOT recommended).
# Find your ID by messaging @userinfobot on Telegram.
AUTHORIZED_USER_IDS=

# System prompts. The Zenvy persona is baked into bot.py as the default —
# only set these to override (must be a single line; use \n for line breaks).
# CHAT_SYSTEM_PROMPT=
# CODE_SYSTEM_PROMPT=

# SQLite path for persistent memory (chat history + user preferences).
# Default: ./zenvy.db relative to the bot's working directory.
# ZENVY_DB_PATH=zenvy.db
